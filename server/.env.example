# MetaModels API server — copy to .env and fill in real values
PORT=5000

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key bypasses RLS — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Allowed CORS origin (frontend dev server)
CLIENT_URL=http://localhost:5173

# Pinata IPFS pinning (https://app.pinata.cloud → API Keys)
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key
